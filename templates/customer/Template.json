{
  "id": "customer",
  "schema_version": 2,
  "version": 2,
  "identity": {
    "strategy": "id"
  },
  "on_missing": "error",
  "allow_create_folder": true,
  "parent": {
    "note_name": "Customers",
    "match_fields": [
      "name",
      "title"
    ],
    "alias_field": "aliases",
    "frontmatter_field": "affiliate_of",
    "link_back_section": "## Affiliates",
    "required": false,
    "on_missing": "auto_create",
    "child_subpath": "Affiliates"
  },
  "root": {
    "type": "md",
    "own_folder": true,
    "plain_filename": true,
    "plain_folder": true,
    "on_existing_title": "error",
    "frontmatter_defaults": {
      "type": "Customer",
      "affiliate_of": "",
      "tags": [
        "kind/customer"
      ]
    },
    "frontmatter_enums": {
      "macc_type": [
        "MACC",
        "EA commitment",
        "Azure Prepayment",
        "Other"
      ],
      "macc_affiliates": [
        "roll up",
        "own"
      ]
    },
    "frontmatter_rules": [
      "The signed Azure commitment is optional and flat: macc_type, macc_amount, macc_currency, macc_start, macc_end, macc_note, macc_includes_marketplace, macc_subtracts_credits, macc_affiliates. A Customer with no commitment has none of them; one with a commitment has all of them",
      "macc_amount is a number, never prose; macc_currency is a three-letter code, USD by default",
      "macc_start and macc_end are dates, YYYY-MM-DD, and macc_end is not before macc_start",
      "macc_includes_marketplace and macc_subtracts_credits are true or false: whether Marketplace counts toward the burn-down and whether credits reduce it",
      "macc_affiliates says how a parent's affiliates relate to its commitment: roll up (they sign none of their own, so their consumption burns the parent's) or own (each signed its own, so only the parent's own enrollments burn it). roll up when absent"
    ],
    "sections": [
      {
        "name": "Summary",
        "access": "machine_write"
      },
      {
        "name": "Personal Notes",
        "access": "human_only"
      },
      {
        "name": "Actions",
        "access": "machine_write"
      },
      {
        "name": "Related",
        "access": "machine_write"
      },
      {
        "name": "Affiliates",
        "access": "machine_write"
      },
      {
        "name": "History & Captures",
        "access": "machine_write"
      }
    ],
    "children_index_section": "History & Captures",
    "children": [
      {
        "suffix": "history",
        "frontmatter_defaults": {
          "type": "History",
          "tags": [
            "kind/history"
          ]
        },
        "name_template": "{title} History",
        "display_label": "History"
      },
      {
        "suffix": "captures",
        "frontmatter_defaults": {
          "type": "Captures",
          "tags": [
            "kind/captures"
          ]
        },
        "name_template": "{title} Captures",
        "display_label": "Captures"
      }
    ]
  }
}
